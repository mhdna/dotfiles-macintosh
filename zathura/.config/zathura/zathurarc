# set adjust-open "best-fit"

#set zoom-min 10

# set sandbox none
# set statusbar-h-padding 0
# set statusbar-v-padding 0
# set page-padding 1

set selection-notification false

set selection-clipboard clipboard

map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
# map j navigate next
# map k navigate next
map p print
map g goto top
map ت scroll down
map ن scroll up
map م scroll right
map ا scroll left
# map أ page-top
# map / page-bottom

# unmap q
set scroll-step 200

map b toggle_statusbar
map <C-n> navigate next
map <C-p> navigate previous
map <Space> navigate next
map <S-Space> navigate previous

set font                        "monospace 15"

# hide bar
# set guioptions none

# Yank file full path keymap
map Y feedkeys ":exec zathura-copy-path $FILE<Return>"

