#!/usr/bin/env bash

# Function to display the current time
display_time() {
	printf "%d:%02d:%02d:%02d" $pause $hours $minutes $seconds
}

# Load timer data from file
timer_file="${XDG_CACHE_HOME:-$HOME/.cache}/timer-status-time.txt"
if [ -f "$timer_file" ]; then
	read -r pause hours minutes seconds <"$timer_file"
else
	pause=0
	hours=0
	minutes=0
	seconds=0
fi

# Initialize pause flag
pause=0

# Main loop
while [ $pause -eq 0 ]; do
	case $BLOCK_BUTTON in
	1) pause=1 ;;
	2)
		pause=1
		seconds=0
		minutes=0
		hours=0
		;;
	3)
		pause=0
		;;
	esac

	echo "T: $(display_time)"
	sleep 1 # Wait for 1 second

	# Increment seconds, minutes, and hours if not paused
	if [ $pause -eq 0 ]; then
		seconds=$((seconds + 1))
		if [ $seconds -eq 60 ]; then
			seconds=0
			minutes=$((minutes + 1))
			if [ $minutes -eq 60 ]; then
				minutes=0
				hours=$((hours + 1))
			fi
		fi
	fi
done

# Save timer data to file
printf "%02d:%02d:%02d" $hours $minutes $seconds >"$timer_file"
