#!/bin/sh

case $BLOCK_BUTTON in
1) setsid -f "$TERMINAL" -e pulsemixer >/dev/null 2>&1 ;;
3) volume -t ;;
4) volume -i 5 ;;
5) volume -d 5 ;;
6) $TERMINAL -e $EDITOR "$0" ;;
esac

