#!/bin/sh

# Kill focused window in Wayland (similar to xkill, but without using mouse)

ans="$(printf "Yes\\nNo" | tofi --placeholder-text "You really want to kill this window?")"
[ "$ans" != "Yes" ] && exit 1

FOCUSED_APP_ID=$(swaymsg -t get_tree | jq '.. | select(.type?) | select(.focused==true).pid')
kill -9 $FOCUSED_APP_ID
