#!/usr/bin/env python3

import sys
import os

def pip_like_bar(val_now, val_max, width):
    char_box = '█'
    chars_partial = ['', '▏', '▎', '▍', '▌', '▋', '▊', '▉']
    char_padding = ' '

    # These two are the same:
    #
    #   (val_now * width) // val_max
    #
    #   int((val_now / val_max) * width)
    #
    # The second one is more intuitive, but the first one is written in
    # a way that is identical to the mod calculation. (And no floats are
    # involved.)
    num_filled = (val_now * width) // val_max
    remainder = (val_now * width) % val_max
    index_partial = (remainder * len(chars_partial)) // val_max

    bar = char_box * num_filled
    bar += chars_partial[index_partial]
    bar += char_padding * (width - len(bar))

    return '│' + bar + '│'

if len(sys.argv) != 4:
    sys.exit(1)

print(pip_like_bar(*[int(i) for i in sys.argv[1:4]]))
