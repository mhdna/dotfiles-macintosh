#!/bin/sh

forecastreport="${XDG_CACHE_HOME:-$HOME/.cache}/weatherreport"

getforecast() {
	curl -sf "wttr.in/Beirut" >"$forecastreport" && curl -sf "wttr.in/?format=%m" >>"$forecastreport" || (
		rm -f "$forecastreport"
		notify-send "🌦️ Weather Forecast" "Something went wrong..."
	)
}

[ "$1" = "get" ] && getforecast

[ -s "$forecastreport" ] && [ "$(stat -c %y "$forecastreport" 2>/dev/null | cut -d' ' -f1)" = "$(date '+%Y-%m-%d')" ] ||
	getforecast

less "$forecastreport"
# "light theme"
# cat "$forecastreport" | sed -e 's:226m:1;30m:g' | less
