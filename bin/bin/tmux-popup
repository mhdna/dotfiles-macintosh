#!/bin/sh
# A toggleable popup terminal: opt+i opens session <name> in a centred popup,
# opt+i inside it closes the popup (the session keeps running).
#
#   tmux-popup <name> [command…]
#
# A new session starts in the folder of the pane you opened it from.

name=$1
[ -z "$name" ] && { tmux display-message "tmux-popup: needs a session name"; exit 1; }
shift

# One query for both: the current session, and the pane's folder.
info=$(tmux display-message -p '#{session_name}	#{pane_current_path}')
session=${info%%	*}
dir=${info#*	}

if [ "$session" = "$name" ]; then
	tmux detach-client # we're inside the popup: close it
	exit 0
fi

# Attach straight away if the session exists (the fast path, nothing else
# runs); only a new session also gets its status bar hidden.
tmux display-popup -E -x C -y C -w 75% -h 75% -d "$dir" \
	-b simple -S 'fg=#8a8a8a,bg=#000000' \
	"env -u TMUX tmux attach-session -t '$name' 2>/dev/null ||
	 env -u TMUX tmux new-session -s '$name' -c '$dir' $* \\; set-option status off" || true
