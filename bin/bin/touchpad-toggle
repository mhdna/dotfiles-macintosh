#!/usr/bin/env bash

# Turns touchpad on/off on X11 and Wayland
[ "$1" = "-t" ] && trackpoint=true

if [ -n "$WAYLAND_DISPLAY" ]; then
	[ "$trackpoint" = true ] && pattern='.name | test("TrackPoint"; "i")' || pattern='.type | test("touchpad"; "i")'
	ID="$(swaymsg -t get_inputs | jq -r ".[] | select($pattern) | .identifier")"
else
	[ "$trackpoint" = true ] && device='(trackpoint)' || device='(touchpad|glidepoint|synaptics)'
	ID=$(xinput --list | grep -Ei "$device" | grep -Eo 'id=[0-9]+' | grep -Eo '[0-9]+')
fi

case "${2:-$1}" in
"on")
	if [[ -n $WAYLAND_DISPLAY ]]; then
		swaymsg input "$ID" events enabled
	else
		if [[ -n $DISPLAY ]]; then
			xinput enable "$ID"
		else
			echo "Error: No Wayland or X11 display detected" >&2
			exit 1
		fi
	fi
	;;
"off")
	if [[ -n $WAYLAND_DISPLAY ]]; then
		swaymsg input "$ID" events disabled
	else
		if [[ -n $DISPLAY ]]; then
			xinput disable "$ID"
		else
			echo "Error: No Wayland or X11 display detected" >&2
			exit 1
		fi
	fi
	;;
*)
	exit 1
	;;
esac
