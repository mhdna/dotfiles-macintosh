#!/bin/sh

set -e

scratch_name="$1"
[ "$scratch_name" = "" ] && echo "You must provide a name."
shift 1
command="$@"

CURRENT_WINDOW="$(tmux display-message -p -F "#{window_name}")"
if echo "$CURRENT_WINDOW" | grep -q "^$scratch_name"; then
	tmux last-window || true
else
	tmux select-window -t "$scratch_name" || tmux new-window -n "$scratch_name" "$command"
fi
