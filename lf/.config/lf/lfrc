cmd resize ${{
	# e.g. :resize 400 400 converts all selected files to that size
	x="$1"
	y="$2"
	for f in $fx; do
		magick "$f" -resize "${x}x${y}" "${f%.*}-resized.png"
	done
}}

cmd convert_image ${{
	ext="$1"
