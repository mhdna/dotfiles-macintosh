# Select files recursively
cmd select-files ${{
    pattern="$1"
    files=$(
        if [ "$lf_hidden" = 'false' ]; then
            # select all files except idden files and files in hidden directories
            gfind "$PWD" -mindepth 1 -type f -not -name '.*' -not -path '*/.*' -name "$pattern" -print0
        else
            gfind "$PWD" -mindepth 1 -type f -name "$pattern" -print0
        fi |
        xargs -0 printf ' %q'
        )
    if [ -n "$(echo "$files" | tr -d ' ')" ]; then
        lf -remote "send :toggle $files"
    else
        lf -remote "send echoerr No matches found"
    fi
}}

# Select directories recursively
cmd select-dirs &{{
    dirs=$(
        if [ "$lf_hidden" = 'false' ]; then
            gfind "$PWD" -mindepth 1 -type d -not -name '.*' -print0
        else
            gfind "$PWD" -mindepth 1 -type d -print0
        fi |
        xargs -0 printf ' %q'
    )
    if [ -n "$(echo "$dirs" | tr -d ' ')" ]; then
        lf -remote "send :unselect; toggle $(get_dirs)"
    else
        lf -remote "send echoerr No matches found"
    fi
}}

