cmd extract &{{
# :extract [out_dir]
out_dir="$*"

if [ -n "$out_dir" ]; then
		mkdir -p "$out_dir"
		cd "$out_dir" || {
				lf -remote "send echoerr unable to create dir"
						exit 1
				}
fi

[ -w . ] || {
		lf -remote "send echoerr unable to extract to \
		\'${out_dir:-.}\'. No write permissions"
		exit 1
}

lf -remote "send echomsg ${f##*/} extracting ..."

case "$f" in
*.tar) cmd="tar -xf $f" ;;
*.tar.bz|*.tbz| \
*.tar.bz2|*.tbz2) cmd="tar -xjf $f" ;;
*.tar.gz|*.tgz) cmd="tar -xzf $f" ;;
*.tar.xz|*.txz) cmd="tar -xJf $f" ;;
*.tar.[zZ]|*.t[zZ]) cmd="tar -xZf $f" ;;
*.tar.lz|*.tlz| \
*.tar.lzma|*.tlzma| \
*.tar.lzo|*.tzo| \
*.tar.zst|*.tzst) cmd="tar -xaf $f" ;;
*.7z) cmd="7za x -- $f" ;;
*.a|*.ar) cmd="ar x -- $f" ;;
*.ace) cmd="unace e -- $f" ;;
*.alz) cmd="unalz -- $f" ;;
*.arc|*.ark|*.ARC|*.ARK) cmd="nomarch -- $f" ;;
*.arj|*.ARJ) cmd="arj e -r -- $f" ;;
*.bz|*.bz2) cmd="bunzip2 -k -- $f" ;;
*.cab|*.CAB|*.exe|*.EXE) cmd="cabextract $f" ;;
*.cpio) cmd="cpio -id -F $f"   ;;
*.deb) cmd="dpkg -x -- $f ." ;;
*.gz) cmd="gunzip -k $f" ;;
*.lha|*.lzh) cmd="lha x $f" ;;
*.lrz|*.lrzip|*.rz) cmd="lrunzip -- $f" ;;
*.lz) cmd="lzip -d -k -- $f" ;;
*.lz4) cmd="unlz4 -- $f" ;;
*.lzma) cmd="xz -d -k $f" ;;
*.lzo) cmd="lzop -x $f" ;;
*.rar) cmd="unrar x -- $f" ;;
*.src.rpm|*.rpm|*.spm) cmd="rpm2cpio $f | cpio -dium" ;;
*.xz) cmd="unxz -k -- $f" ;;
*.[zZ]) cmd="uncompress -- $f" ;;
*.zip|*.osz) cmd="unzip -- $f" ;;
*.zst) cmd="unzstd -- $f" ;;
*.AppImage) cmd ="./$f --appimage-extract" ;;
*) lf -remote "send echoerr ${f##*/} unknown archive format"
exit 0;;
esac

[ -n "$cmd" ] && $TERMINAL -e $cmd

if [ -n "$out_dir" ]; then
lf -remote "send select '$out_dir'"
fi

lf -remote "send reload"
lf -remote "send echomsg ${f##*/} extracted."
}}

